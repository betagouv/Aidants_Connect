{% load ac_common %}

<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Marianne, arial, sans-serif" font-weight="400" line-height="1.5" />
      <mj-section padding="0" />
      <mj-text
        color="#161616"
        font-size="16px"
        line-height="1.5"
        padding="8px 0"
      />
      <mj-button
        background-color="#000091"
        color="#FFFFFF"
        border-radius="0"
        font-size="16px"
        font-weight="700"
        inner-padding="10px 24px"
        padding="16px 0"
      />
    </mj-attributes>
    {% if email_title %}<mj-title>{{ email_title }}</mj-title>{% endif %}
    <mj-style inline="inline">
      a {
        color: #000091 !important;
      }
      a.fr-link {
        color: #000091 !important;
      }
      /* Keep CTA label white: the rule above would otherwise paint it blue on blue */
      td[bgcolor="#000091"] a {
        color: #FFFFFF !important;
      }
      h1 {
        color: #161616;
        font-size: 28px;
        font-weight: 700;
        line-height: 1.25;
        margin: 0;
      }
      p {
        margin: 0 0 12px 0;
      }
      ul, ol {
        margin: 0 0 12px 0;
        padding-left: 24px;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#F5F5FE" width="600px">
    {# Institutional header — DSFR bloc-marque + service on one line #}
    <mj-section background-color="#FFFFFF" padding="24px 32px 16px">
      <mj-group>
        <mj-column width="28%" vertical-align="middle" padding="0">
          <mj-image
            src="data:image/png;base64,"
            alt="République Française"
            width="90px"
            align="left"
            padding="0"
          />
        </mj-column>
        <mj-column width="72%" vertical-align="middle" padding="0">
          <mj-image
            src="data:image/png;base64,"
            alt="Aidants Connect"
            width="140px"
            align="left"
            padding="0"
          />
          <mj-text font-size="12px" color="#666666" padding="4px 0 0">
            Sécuriser les professionnels dans l'accompagnement aux démarches
          </mj-text>
        </mj-column>
      </mj-group>
    </mj-section>

    {% if email_title %}
    <mj-section background-color="#ECECFE" padding="24px 32px">
      <mj-column padding="0">
        <mj-text padding="0">
          <h1>{{ email_title }}</h1>
        </mj-text>
      </mj-column>
    </mj-section>
    {% endif %}

    <mj-wrapper background-color="#FFFFFF" padding="24px 32px">
      {% block email_body %}{% endblock %}

      <mj-section padding="16px 0 0">
        <mj-column padding="0">
          {% block email_signature %}
          <mj-divider border-color="#EEEEEE" border-width="1px" padding="8px 0 16px" />
          <mj-text font-weight="700" padding="0 0 8px">
            À bientôt sur Aidants Connect !
          </mj-text>
          <mj-text padding="0" font-size="14px" color="#666666">
            <span style="font-weight: 700; color: #161616;">L’équipe Aidants Connect</span>
            <br/>
            Pour toute demande : {% mailto "contact@aidantsconnect.beta.gouv.fr" %}
          </mj-text>
          {% endblock email_signature %}
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section padding="24px 32px">
      <mj-column padding="0">
        <mj-text align="center" font-size="12px" color="#666666" padding="0">
          Cet e-mail a été envoyé automatiquement, merci de ne pas y répondre directement.
          <br/>
          <a href="https://aidantsconnect.beta.gouv.fr/">aidantsconnect.beta.gouv.fr</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
