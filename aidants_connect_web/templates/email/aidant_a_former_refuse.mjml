{% extends "layouts/email-base.mjml" %}

{% load ac_common %}

{% block email_body %}
  <mj-section>
    <mj-column>
      <mj-text>
        <p>Bonjour,</p>
        <p>
          Nous n'avons pas pu valider l'ajout de l'aidant {{ aidant.first_name }} {{ aidant.last_name }} {% mailto aidant.email %}.
        </p>
        <p>
          <strong>Motif :</strong> Cela est certainement dû à l'adresse e-mail indiquée. Pour rappel, chaque aidant doit disposer d’une adresse e-mail professionnelle, nominative et individuelle au format : prenom.nom@xxx.fr ou p.nom@xxx.fr
        </p>
        <mj-text>
        L’équipe Aidants Connect<br>
        Accompagnez vos usagers en toute sécurité<br>
        Pour toute demande : <a href="mailto:contact@aidantsconnect.beta.gouv.fr">contact@aidantsconnect.beta.gouv.fr</a>
        </mj-text>
      </mj-text>
    </mj-column>
  </mj-section>
{% endblock email_body %}
