{% extends "layouts/email-base.mjml" %}

{% load ac_common %}

{% block email_body %}
  <mj-section>
    <mj-column>
      <mj-text>
        <p>Bonjour {{ user.get_full_name }},</p>
        <p>
          Comme annoncé lors de notre précédente relance, votre compte a été désactivé pour des raisons de
          sécurité, conformément <a href="{{ cgu_url }}">aux CGU d’Aidants Connect</a>.
        </p>
        <p>
          Merci pour votre passage sur Aidants Connect !
        </p>
        <p>
          Si vous souhaitez finalement réactiver votre copmte, vous pouvez contacter le référent de votre structure qui pourra réaliser cette action depuis son espace.
        </p>
      </mj-text>
    </mj-column>
  </mj-section>
{% endblock email_body %}
