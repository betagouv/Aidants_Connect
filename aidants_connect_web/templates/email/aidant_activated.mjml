{% extends "layouts/email-base.mjml" %}

{% load ac_common %}

{% block email_body %}
<mj-section>
  <mj-column>
    <mj-text>Bonjour {{ referent.get_full_name }},</mj-text>
    <mj-text>
      <p>
      👏 {{ aidant.get_full_name }} a finalisé sa formation Aidants Connect.
      </p>
      <p>
      Son compte est maintenant créé, mais une dernière étape est nécessaire avant qu'il puisse utiliser Aidants Connect : <strong>associer un moyen de connexion</strong> depuis votre espace référent.
      </p>
      <p>
      L'aidant devra avoir son téléphone à disposition pour réaliser cette opération avec vous.
      </p>
      <p>
      👉 Retrouvez la procédure étape par étape : {{EMAIL_AIDANT_ACTIVATED_CARD_ASSOCIATION_GUIDE}}
      </p>
    </mj-text>
    <mj-text>
    L’équipe Aidants Connect<br>
    Accompagnez vos usagers en toute sécurité<br>
    Pour toute demande : <a href="mailto:contact@aidantsconnect.beta.gouv.fr">contact@aidantsconnect.beta.gouv.fr</a>
    </mj-text>
  </mj-column>
</mj-section>
{% endblock email_body %}
